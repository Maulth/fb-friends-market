{
  "manifest_version": 3,
  "name": "FB Friends & Market",
  "version": "0.1.0",
  "description": "Facebook, reduced to your friends and Marketplace. Fork of Zuckless (MIT).",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "*://facebook.com/*",
    "*://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FB Friends & Market",
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "redirect_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://facebook.com/*",
        "*://www.facebook.com/*"
      ],
      "css": [
        "facebook.css"
      ],
      "js": [
        "gate.js",
        "facebook.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
